# Read at build time by webpack.config.js (DefinePlugin) and injected into the bundle.
# Export them in your shell or in CI before running "pnpm build".

# Where the orchestrator backend lives, including the /api suffix.
MFE_BACKEND_URL=https://console.mfe-orchestrator.dev/api

# Id of your project in the orchestrator.
MFE_PROJECT_ID=

# OPTIONAL. Orchestrator environment slug, ex. DEV / STAGE / PROD. Leave it unset and the backend
# resolves the environment from the domain the page is served on, out of the domains declared for
# each environment in the console. Set it when the host already knows where it runs, or when one
# domain serves more than one environment.
# MFE_ENVIRONMENT=DEV
